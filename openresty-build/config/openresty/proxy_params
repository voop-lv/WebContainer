# Reverse-proxy defaults (superset of Debian's /etc/nginx/proxy_params).
# Usage inside a location:
#     include proxy_params;
#     proxy_pass http://127.0.0.1:3000;
proxy_http_version 1.1;

# Client identity for the upstream
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Port $server_port;

# WebSocket pass-through: forwards the client's own Upgrade/Connection headers, so no http-level map is needed
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $http_connection;

# Don't leak upstream implementation details
proxy_hide_header X-Powered-By;
proxy_hide_header Server;

proxy_redirect off;
proxy_connect_timeout 60s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;
proxy_buffer_size 32k;
proxy_buffers 16 16k;
proxy_busy_buffers_size 64k;
